{
  "rax-config": {
    "description": "Back up, restore and reset persistent ImmortalWrt settings",
    "read": { "ubus": { "rax.config": ["status"] } },
    "write": {
      "ubus": { "rax.config": ["backup", "check", "restore", "reset"], "file": ["read", "write"] },
      "file": {
        "/tmp/rax-backup.tar.gz": ["read"],
        "/tmp/rax-config-upload.tar.gz": ["write"]
      }
    }
  }
}
